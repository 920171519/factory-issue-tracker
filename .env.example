# SQLite 数据文件（生产环境建议放在持久化卷上）
DATABASE_PATH=./data/app.db

# 会话签名密钥，生产环境必须替换为至少 32 字节的随机字符串
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# 业务时区，默认 Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# 内置交班检查调度器（单实例部署时开启；也可用外部 cron 调用 /api/jobs/handoff）
ENABLE_SCHEDULER=true

# 外部定时任务调用交班接口时使用的密钥
CRON_SECRET=replace-with-another-random-secret
# 图片上传目录（生产环境同样需持久化）
UPLOAD_DIR=./data/uploads

# 若部署在无 HTTPS 的内网，可设置为 false；公网部署请保持 true/不设置
COOKIE_SECURE=true
