{
  "name": "factory-issue-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "责任组制问题定位跟踪系统",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:api": "node scripts/e2e-api.mjs",
    "test:ui": "node scripts/ui-smoke.mjs && node scripts/ui-flows.mjs",
    "test:ui:flows": "node scripts/ui-flows.mjs",
    "backup": "node scripts/backup.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "admin:grant": "tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "xlsx": "0.18.5",
    "zod": "4.1.12"
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
